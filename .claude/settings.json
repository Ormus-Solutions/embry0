{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(//workspace/**)",
      "Write(//workspace/**)",
      "Edit(//workspace/**)",
      "Glob(//workspace/**)"
    ],
    "deny": [
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(~/.claude/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(//proc/**)",
      "Write(//etc/**)",
      "Write(//root/**)",
      "Write(//usr/**)",
      "Write(//bin/**)",
      "Write(//sbin/**)",
      "Edit(//etc/**)",
      "Edit(//root/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Write(//workspace/.claude/settings*.json)",
      "Edit(//workspace/.claude/settings*.json)",
      "Glob(//etc/**)",
      "Glob(//root/**)",
      "Glob(~/.claude/**)",
      "Glob(~/.ssh/**)",
      "Glob(~/.aws/**)",
      "Glob(~/.gnupg/**)",
      "Glob(//proc/**)",
      "Grep(//etc/**)",
      "Grep(//root/**)",
      "Grep(~/.claude/**)",
      "Grep(~/.ssh/**)",
      "Grep(~/.aws/**)",
      "Grep(~/.gnupg/**)",
      "Grep(//proc/**)"
    ]
  }
}